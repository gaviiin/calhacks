# Server-side only. Never expose these to the browser or commit them.
APIFY_TOKEN=
# Set after `apify push` (e.g. "<username>/fia-document-monitor")
APIFY_ACTOR_ID=
# Decision reader, after `npm run actor:push:reader`
APIFY_DECISION_ACTOR_ID=
SPACETIME_URL=http://127.0.0.1:3000
SPACETIME_DB=pit-wall
# Token of the identity that published the module (`spacetime login show --token`)
SPACETIME_TOKEN=

# ---------------------------------------------------------------- finance (Pit Wall)
ANTHROPIC_API_KEY=
PITWALL_AGENT=scripted            # 'claude' to use the model for drafting, reading answers and explanations
SPACETIME_MIRROR=0                # 1 to stream entries into SpacetimeDB for the live UI

# ---------------------------------------------------------------- communication integrations
PITWALL_NOTIFY=dry                # dry (render to outbox only) | live | off
PITWALL_SECRET=                   # long random string; signs approval links and webhooks (required for live)
PITWALL_PUBLIC_URL=http://localhost:8000   # where email/Teams links point (your tunnel URL in the demo)
PITWALL_UI_URL=http://localhost:5173

# Slack: bot token gives buttons + thread answers; a webhook alone gives text + links
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_FINANCE=#pit-wall
SLACK_WEBHOOK_URL=

# Email over SMTP (Gmail: smtp.gmail.com, 587, an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Microsoft Teams: Workflows "Post to a channel when a webhook request is received"
TEAMS_WEBHOOK_URL=

# SMS via Twilio (urgent items only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Generic signed webhook (Zapier, n8n, red-team harness)
PITWALL_WEBHOOK_URL=

# People (synthetic personas; point these at teammates for the demo)
SLACK_USER_DANA=
SLACK_USER_PRIYA=
SLACK_USER_LUIS=
EMAIL_DANA=
EMAIL_PRIYA=
EMAIL_LUIS=
PHONE_PRIYA=
EMAIL_SPONSOR_HALCYON=
EMAIL_SPONSOR_VOLTA=
EMAIL_SPONSOR_ARCADIA=
EMAIL_SPONSOR_NORTHWIND=
EMAIL_SPONSOR_RIDGELINE=
