# Server-side only. Never expose these to the browser or commit them.
APIFY_TOKEN=
# Set after `apify push` (e.g. "<username>/fia-document-monitor")
APIFY_ACTOR_ID=
# Decision reader, after `npm run actor:push:reader`
APIFY_DECISION_ACTOR_ID=
SPACETIME_URL=http://127.0.0.1:3000
SPACETIME_DB=pit-wall
# Token of the identity that published the module (`spacetime login show --token`)
SPACETIME_TOKEN=

# ---------------------------------------------------------------- Claude (both desks)
ANTHROPIC_API_KEY=
# CCD_MODEL=claude-opus-5-5        # cost cap desk: Cap Analyst and Policy Learner

# ---------------------------------------------------------------- cost cap desk (agents/)
# STDB_URL=http://localhost:3000   # STDB_DB=cost-cap-desk  WORLD_URL=http://localhost:8010
# GATEWAY_KEY is set by the Makefile for local runs (dev-gateway-key); never reuse it anywhere real

# ---------------------------------------------------------------- revenue desk (finance/)
PITWALL_AGENT=scripted            # 'claude' to use the model for drafting, reading answers and explanations
SPACETIME_MIRROR=0                # 1 to stream entries into SpacetimeDB for the live UI

# ---------------------------------------------------------------- communication integrations
PITWALL_NOTIFY=dry                # dry (render to outbox only) | live | off
PITWALL_SECRET=                   # long random string; signs approval links and webhooks (required for live)
PITWALL_PUBLIC_URL=http://localhost:8000   # where email/Teams links point (your tunnel URL in the demo)
PITWALL_UI_URL=http://localhost:5173

# Slack: bot token gives buttons + thread answers; a webhook alone gives text + links
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_FINANCE=#pit-wall
SLACK_WEBHOOK_URL=

# Email over SMTP (Gmail: smtp.gmail.com, 587, an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Microsoft Teams: Workflows "Post to a channel when a webhook request is received"
TEAMS_WEBHOOK_URL=

# SMS via Twilio (urgent items only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Generic signed webhook (Zapier, n8n, red-team harness)
PITWALL_WEBHOOK_URL=

# People (synthetic personas; point these at teammates for the demo)
SLACK_USER_DANA=
SLACK_USER_PRIYA=
SLACK_USER_LUIS=
EMAIL_DANA=
EMAIL_PRIYA=
EMAIL_LUIS=
PHONE_PRIYA=
EMAIL_SPONSOR_HALCYON=
EMAIL_SPONSOR_VOLTA=
EMAIL_SPONSOR_ARCADIA=
EMAIL_SPONSOR_NORTHWIND=
EMAIL_SPONSOR_RIDGELINE=

# ---------------------------------------------------------------- Microsoft (docs/microsoft/README.md)
# One Entra ID app registration for Graph, Business Central and (optionally) Azure OpenAI.
# In Azure, leave MS_CLIENT_SECRET empty and set PITWALL_MS_AUTH=managed_identity instead.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
PITWALL_MS_AUTH=                  # managed_identity in Azure Container Apps

# Independent auditor's second opinion on Azure OpenAI (a different model family from the Claude preparer)
AZURE_OPENAI_ENDPOINT=            # https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=          # your deployment name, e.g. gpt-4.1-mini
AZURE_OPENAI_API_KEY=             # or leave empty to use Entra ID
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_REASONING=0          # 1 for o-series / gpt-5 deployments (max_completion_tokens, no temperature)
PITWALL_AUDITOR=auto              # rules to force the rule-based reviewer

# Outlook / Exchange Online through Microsoft Graph (Mail.Send application permission)
EMAIL_TRANSPORT=smtp              # graph to send through Graph instead of SMTP
GRAPH_SENDER=                     # the finance mailbox Pit Wall sends from

# Dynamics 365 Business Central general journal (API.ReadWrite.All application permission)
BC_TENANT_ID=                     # defaults to MS_TENANT_ID
BC_ENVIRONMENT=Sandbox
BC_COMPANY_ID=
BC_JOURNAL_ID=
BC_ACCOUNT_MAP=                   # optional; default integrations/business_central_accounts.json

# Azure Monitor / Application Insights (pip install -r deploy/azure/requirements-azure.txt)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Evidence seals: chain heads anchored to Azure Confidential Ledger as well as a local file
PITWALL_SEALS=1
PITWALL_ANCHOR_EVERY=25
AZURE_CONFIDENTIAL_LEDGER_ENDPOINT=   # https://<name>.confidential-ledger.azure.com

# Impact metrics: your own numbers for the labelled assumptions
PITWALL_MIN_PER_ENTRY=6
PITWALL_MIN_PER_BILLING_CHECK=20
PITWALL_CLOSE_BUSINESS_DAYS=5

# Race desk (race/)
TYPESAFE_API_KEY=            # Jev, TypeSafe AI's System One model; empty = offline rule table
OPENF1_USERNAME=             # OpenF1 Sponsor tier, live MQTT only
OPENF1_PASSWORD=
RACE_TEAM=Williams
RACE_OFFLINE=                # 1 = no Jev, no Claude, no network
