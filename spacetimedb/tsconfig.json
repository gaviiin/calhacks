/*
 * Based on the tsconfig generated by `spacetime init --lang typescript`.
 * The target/lib/module/isolatedModules/noEmit options are required by SpacetimeDB.
 */
{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./src/**/*"]
}
