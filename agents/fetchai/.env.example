# Pit Wall API the agents read from (run uvicorn finance.api:app --port 8000)
PITWALL_API_URL=http://localhost:8000
PITWALL_RUN_ID=                 # empty: newest run, or start a 2024 run with remittances left to agents

# Pit Wall agent
PITWALL_AGENT_SEED=             # long random phrase; fixes the agent's address
PITWALL_AGENT_PORT=8011
PITWALL_COLLECT=1               # send open bonus invoices to sponsors as RequestPayment
PITWALL_COLLECT_EVERY=60
PITWALL_COLLECT_BATCH=3
SPONSOR_AGENT=                  # address printed by sponsor_agent.py (or SPONSOR_AGENT_HALCYON=..., per sponsor)

# Sponsor accounts-payable agent
SPONSOR_AGENT_SEED=             # another long random phrase
SPONSOR_AGENT_PORT=8012
SPONSOR_IDS=halcyon,volta,arcadia,northwind,ridgeline
VERIFY_OFFLINE=0                # 1: check results against the cached copy instead of the Jolpica-F1 API

# Optional: ASI:One model for understanding questions (https://asi1.ai/dashboard/api-keys)
ASI1_API_KEY=

AGENT_MAILBOX=1                 # 0 for local testing without Agentverse
